opam-version: "2.0"
synopsis: "inspect OCaml values as heap graphs"
description:
  "graphis inspects OCaml values, preserves sharing, and emits Graphviz DOT heap graphs"
maintainer: ""
authors: ""
license: "MIT"
depends: [
  "ocaml" {>= "5.0"}
  "dune"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test} "@doc" {with-doc}]
]
